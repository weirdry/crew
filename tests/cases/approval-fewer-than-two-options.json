{
  "id": "approval-fewer-than-two-options",
  "script": "approval.sh",
  "args": ["check", "crew-worker"],
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {"{state}/.current": "run-1\n", "{state}/worker.json": {"json": {"version": 1, "worker_pane_id": "worker-1", "worker_name": "crew-worker"}}}
  },
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "Would you like to run the following command?\n\n$ echo one\n\n1. Yes\n"}]}
  ],
  "expect": {
    "status": 4,
    "stderr_contains": ["confirmation or option list is absent"],
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]]
  }
}
