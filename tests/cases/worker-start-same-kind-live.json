{
  "id": "worker-start-same-kind-live",
  "script": "worker-start.sh",
  "args": ["codex"],
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      "{state}/.current": "run-1\n",
      "{state}/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "codex"}}
    }
  },
  "herdr": [
    {"argv": ["agent", "list"], "results": [{"agents": [{"pane_id": "lead-1", "agent": "codex"}]}]},
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"name": "crew-worker", "pane_id": "worker-1", "agent": "codex"}}]}
  ],
  "expect": {
    "status": 12,
    "stderr_contains": ["outcome=refused:same-kind", "retained_partner_kind=codex"],
    "calls_exact": [["agent", "list"], ["agent", "get", "crew-worker"]]
  }
}
