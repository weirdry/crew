{
  "id": "approval-grant-edit-missing-ops-refused",
  "script": "approval.sh",
  "args": ["propose", "crew-worker", "--root", "{grant_root}"],
  "setup": {"dirs": [".crew/run-1"], "files": {"{state}/.current": "run-1\n", "{state}/worker.json": {"json": {"version": 1, "worker_pane_id": "worker-1", "worker_name": "crew-worker"}}}},
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "────────────\n• Edited {grant_root}/a.txt (+1 -1)\n\nWould you like to make the following edits?\nDestination: {grant_root}/a.txt\n\n1. Yes\n2. No\n"}]}
  ],
  "expect": {"status": 2, "stderr_contains": ["--ops is required"], "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]]}
}
