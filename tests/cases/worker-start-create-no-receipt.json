{
  "id": "worker-start-create-no-receipt",
  "script": "worker-start.sh",
  "args": ["codex"],
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {"dirs": [".crew/run-1"], "files": {".crew/.current": "run-1\n"}},
  "herdr": [
    {"argv": ["agent", "list"], "results": [{"agents": [{"pane_id": "lead-1", "agent": "claude"}]}]},
    {"argv": ["agent", "get", "{derived_name}"], "results": [{"error": "agent_not_found"}]},
    {"argv": ["pane", "layout", "--pane", "lead-1"], "results": [{"layout": {"panes": [{"pane_id": "lead-1", "rect": {"width": 100, "height": 40}}]}}]},
    {"argv": ["pane", "split", "--pane", "lead-1", "--direction", "right", "--cwd", "{cwd}", "--no-focus"], "results": [{"pane": {"pane_id": "split-1"}}]},
    {"argv": ["pane", "wait-output", "split-1", "--regex", "[#$%>❯] ?$", "--source", "detection", "--lines", "5", "--timeout", "60000"], "results": [{}]},
    {"argv": ["agent", "start", "{derived_name}", "--kind", "codex", "--pane", "split-1", "--timeout", "60000"], "results": [{}]},
    {"argv": ["pane", "wait-output", "split-1", "--regex", "Ask Codex", "--source", "visible", "--timeout", "60000"], "results": [{}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["outcome=created", "partner_name={derived_name}", "pane_source=split", "receipt_action=created"],
    "calls_exact": [
      ["agent", "list"], ["agent", "get", "{derived_name}"], ["pane", "layout", "--pane", "lead-1"],
      ["pane", "split", "--pane", "lead-1", "--direction", "right", "--cwd", "{cwd}", "--no-focus"],
      ["pane", "wait-output", "split-1", "--regex", "[#$%>❯] ?$", "--source", "detection", "--lines", "5", "--timeout", "60000"],
      ["agent", "start", "{derived_name}", "--kind", "codex", "--pane", "split-1", "--timeout", "60000"],
      ["pane", "wait-output", "split-1", "--regex", "Ask Codex", "--source", "visible", "--timeout", "60000"]
    ],
    "json_files": {".crew/worker.json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "split-1", "worker_name": "{derived_name}", "worker_kind": "codex"}}
  }
}
