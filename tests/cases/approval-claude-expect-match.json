{
  "id": "approval-claude-expect-match",
  "script": "approval.sh",
  "args": ["check", "crew-worker", "--expect-b64", "{command_b64}"],
  "command": "echo claude",
  "frame_evidence": "synthetic; the Claude layout branch is not verified against a live Claude permission dialog",
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      ".crew/.current": "run-1\n",
      ".crew/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "claude"}}
    }
  },
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "────────────\nBash command\necho claude\n────────────\nAllow this command?\n1. Allow\n2. Deny\n"}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["command_b64={command_b64}", "outcome=expected-match"],
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]]
  }
}
