{
  "id": "worker-start-stale-pane-reused",
  "script": "worker-start.sh",
  "args": ["codex"],
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      ".crew/.current": "run-1\n",
      ".crew/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "codex"}}
    }
  },
  "herdr": [
    {"argv": ["agent", "list"], "results": [{"agents": [{"pane_id": "lead-1", "agent": "claude"}]}]},
    {"argv": ["agent", "get", "crew-worker"], "results": [{"error": "agent_not_found"}]},
    {"argv": ["pane", "get", "worker-1"], "results": [{"pane": {"pane_id": "worker-1"}}]},
    {"argv": ["pane", "wait-output", "worker-1", "--regex", "[#$%>❯] ?$", "--source", "detection", "--lines", "5", "--timeout", "60000"], "results": [{}]},
    {"argv": ["agent", "start", "crew-worker", "--kind", "codex", "--pane", "worker-1", "--timeout", "60000"], "results": [{}]},
    {"argv": ["pane", "wait-output", "worker-1", "--regex", "Ask Codex", "--source", "visible", "--timeout", "60000"], "results": [{}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["pane_source=reused", "receipt_action=replaced-stale"],
    "calls_exact": [
      ["agent", "list"], ["agent", "get", "crew-worker"], ["pane", "get", "worker-1"],
      ["pane", "wait-output", "worker-1", "--regex", "[#$%>❯] ?$", "--source", "detection", "--lines", "5", "--timeout", "60000"],
      ["agent", "start", "crew-worker", "--kind", "codex", "--pane", "worker-1", "--timeout", "60000"],
      ["pane", "wait-output", "worker-1", "--regex", "Ask Codex", "--source", "visible", "--timeout", "60000"]
    ],
    "calls_absent_prefix": [["pane", "split"]]
  }
}
