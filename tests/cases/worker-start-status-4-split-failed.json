{
  "id": "worker-start-status-4-split-failed",
  "script": "worker-start.sh",
  "args": ["other"],
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {"dirs": [".crew/run-1"], "files": {"{state}/.current": "run-1\n"}},
  "herdr": [
    {"argv": ["agent", "list"], "results": [{"agents": [{"pane_id": "lead-1", "agent": "claude"}]}]},
    {"argv": ["agent", "get", "{derived_name}"], "results": [{"error": "agent_not_found"}]},
    {"argv": ["pane", "layout", "--pane", "lead-1"], "results": [{"layout": {"panes": [{"pane_id": "lead-1", "rect": {"width": 100, "height": 40}}]}}]},
    {"argv": ["pane", "split", "--pane", "lead-1", "--direction", "right", "--cwd", "{cwd}", "--no-focus"], "results": [{"status": 1}]}
  ],
  "expect": {
    "status": 4,
    "calls_exact": [["agent", "list"], ["agent", "get", "{derived_name}"], ["pane", "layout", "--pane", "lead-1"], ["pane", "split", "--pane", "lead-1", "--direction", "right", "--cwd", "{cwd}", "--no-focus"]]
  }
}
