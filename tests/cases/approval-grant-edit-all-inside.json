{
  "id": "approval-grant-edit-all-inside",
  "script": "approval.sh",
  "args": ["propose", "crew-worker", "--root", "{cwd}/fixtures", "--ops", "create,modify"],
  "setup": {"dirs": [".crew/run-1", "fixtures"], "files": {"{state}/.current": "run-1\n", "{state}/worker.json": {"json": {"version": 1, "worker_pane_id": "worker-1", "worker_name": "crew-worker"}}}},
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "────────────────────────\n• Edited {cwd}/fixtures/a.txt (+1 -1)\n• Edited {cwd}/fixtures/b.txt (+1 -1)\n\nWould you like to make the following edits?\nDestination: {cwd}/fixtures/a.txt\nDestination: {cwd}/fixtures/b.txt\n\n1. Yes\n2. No\n"}]}
  ],
  "expect": {"status": 0, "stdout_contains": ["Allow edit dialogs for create or modify", "outcome=proposed"], "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]]}
}
