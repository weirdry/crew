{
  "id": "worker-start-create-live-refused",
  "script": "worker-start.sh",
  "args": ["--create", "codex"],
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      ".crew/.current": "run-1\n",
      ".crew/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "codex"}}
    }
  },
  "herdr": [
    {"argv": ["agent", "list"], "results": [{"agents": [{"pane_id": "lead-1", "agent": "claude"}]}]},
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"name": "crew-worker", "pane_id": "worker-1", "agent": "codex"}}]}
  ],
  "expect": {
    "status": 13,
    "stderr_contains": ["outcome=refused:partner-live"],
    "calls_exact": [["agent", "list"], ["agent", "get", "crew-worker"]]
  }
}
