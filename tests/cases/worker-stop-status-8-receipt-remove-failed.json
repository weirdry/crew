{
  "id": "worker-stop-status-8-receipt-remove-failed",
  "script": "worker-stop.sh",
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {"files": {"{state}/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "codex"}}}},
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent": "codex"}}, {"agent": {"pane_id": "worker-1", "agent": "codex"}}]},
    {
      "argv": ["pane", "close", "worker-1"],
      "results": [{"effects": [{"action": "write", "path": "{state}/worker.json", "content_json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-2", "worker_name": "crew-worker", "worker_kind": "codex"}}]}]
    }
  ],
  "expect": {
    "status": 8,
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "get", "crew-worker"], ["pane", "close", "worker-1"]],
    "json_files": {"{state}/worker.json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-2", "worker_name": "crew-worker", "worker_kind": "codex"}}
  }
}
