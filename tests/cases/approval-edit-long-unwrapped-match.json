{
  "id": "approval-edit-long-unwrapped-match",
  "script": "approval.sh",
  "args": ["check", "crew-worker"],
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      "{state}/.current": "run-1\n",
      "{state}/worker.json": {"json": {"version": 1, "worker_pane_id": "worker-1", "worker_name": "crew-worker"}},
      "{state}/run-1/approvals.jsonl": "{\"key\": {\"destinations\": [\"/private/tmp/long-unwrapped-destination-file.txt\"], \"operation\": \"modify\"}, \"kind\": \"edit\"}\n"
    }
  },
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "────────────────────────\n• Edited /private/tmp/long-unwrapped-destination-file.txt (+2 -2)\n\nWould you like to make the following edits?\nDescription: Apply proposed file edits\nDestination: /private/tmp/long-unwrapped-destination-file.txt\n\n1. Yes\n2. No\n"}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["approval_kind=edit", "outcome=match"],
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]]
  }
}
