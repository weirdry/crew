{
  "id": "worker-start-explicit-lead-pane-session",
  "script": "worker-start.sh",
  "args": ["--lead-pane", "lead-1", "--session", "test-session", "codex"],
  "env": {"HERDR_ENV": "0", "HERDR_PANE_ID": "wrong-pane", "CODEX_THREAD_ID": "synthetic-codex-thread"},
  "setup": {"dirs": [".crew/run-1"], "files": {"{state}/.current": "run-1\n"}},
  "herdr": [
    {"argv": ["--session", "test-session", "agent", "list"], "results": [{"agents": [{"pane_id": "lead-1", "agent": "claude"}]}]},
    {"argv": ["--session", "test-session", "agent", "get", "{derived_name}"], "results": [{"error": "agent_not_found"}]},
    {"argv": ["--session", "test-session", "pane", "layout", "--pane", "lead-1"], "results": [{"layout": {"panes": [{"pane_id": "lead-1", "rect": {"width": 100, "height": 40}}]}}]},
    {"argv": ["--session", "test-session", "pane", "split", "--pane", "lead-1", "--direction", "right", "--cwd", "{cwd}", "--no-focus"], "results": [{"pane": {"pane_id": "split-1"}}]},
    {"argv": ["--session", "test-session", "pane", "wait-output", "split-1", "--regex", "[#$%>❯] ?$", "--source", "detection", "--lines", "5", "--timeout", "60000"], "results": [{}]},
    {"argv": ["--session", "test-session", "agent", "start", "{derived_name}", "--kind", "codex", "--pane", "split-1", "--timeout", "60000", "--", "--sandbox", "workspace-write", "--ask-for-approval", "on-request", "-c", "approvals_reviewer=\"user\"", "-c", "sandbox_workspace_write.writable_roots=[]"], "results": [{}]},
    {"argv": ["--session", "test-session", "pane", "wait-output", "split-1", "--regex", "Ask Codex", "--source", "visible", "--timeout", "60000"], "results": [{}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["outcome=created", "partner_name={derived_name}", "pane_source=split", "receipt_action=created"],
    "calls_exact": [
      ["--session", "test-session", "agent", "list"], ["--session", "test-session", "agent", "get", "{derived_name}"], ["--session", "test-session", "pane", "layout", "--pane", "lead-1"],
      ["--session", "test-session", "pane", "split", "--pane", "lead-1", "--direction", "right", "--cwd", "{cwd}", "--no-focus"],
      ["--session", "test-session", "pane", "wait-output", "split-1", "--regex", "[#$%>❯] ?$", "--source", "detection", "--lines", "5", "--timeout", "60000"],
      ["--session", "test-session", "agent", "start", "{derived_name}", "--kind", "codex", "--pane", "split-1", "--timeout", "60000", "--", "--sandbox", "workspace-write", "--ask-for-approval", "on-request", "-c", "approvals_reviewer=\"user\"", "-c", "sandbox_workspace_write.writable_roots=[]"],
      ["--session", "test-session", "pane", "wait-output", "split-1", "--regex", "Ask Codex", "--source", "visible", "--timeout", "60000"]
    ],
    "json_files": {"{state}/worker.json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "split-1", "worker_name": "{derived_name}", "worker_kind": "codex"}}
  }
}
