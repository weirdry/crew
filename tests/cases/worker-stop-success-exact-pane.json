{
  "id": "worker-stop-success-exact-pane",
  "script": "worker-stop.sh",
  "env": {"HERDR_ENV": "1", "HERDR_PANE_ID": "lead-1"},
  "setup": {"files": {".crew/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "codex"}}}},
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent": "codex"}}, {"agent": {"pane_id": "worker-1", "agent": "codex"}}]},
    {"argv": ["pane", "close", "worker-1"], "results": [{}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["closed_pane_id=worker-1", "worker_name=crew-worker"],
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "get", "crew-worker"], ["pane", "close", "worker-1"]],
    "absent": [".crew/worker.json"]
  }
}
