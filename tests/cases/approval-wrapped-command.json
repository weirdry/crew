{
  "id": "approval-wrapped-command",
  "script": "approval.sh",
  "args": ["check", "crew-worker", "--expect-b64", "{command_b64}"],
  "command": "printf one\n  continued-row",
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      ".crew/.current": "run-1\n",
      ".crew/worker.json": {"json": {"version": 1, "lead_pane_id": "lead-1", "worker_pane_id": "worker-1", "worker_name": "crew-worker", "worker_kind": "codex"}}
    }
  },
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "Would you like to run the following command?\n\n$ printf one\n  continued-row\n\n1. Yes\n2. No\n"}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["outcome=expected-match"],
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]]
  }
}
