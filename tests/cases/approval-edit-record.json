{
  "id": "approval-edit-record",
  "script": "approval.sh",
  "args": ["record", "crew-worker"],
  "command": "{\"key\":{\"destinations\":[\"/private/tmp/edit-a.txt\"],\"operation\":\"modify\"},\"kind\":\"edit\"}",
  "setup": {
    "dirs": [".crew/run-1"],
    "files": {
      "{state}/.current": "run-1\n",
      "{state}/worker.json": {"json": {"version": 1, "worker_pane_id": "worker-1", "worker_name": "crew-worker"}}
    }
  },
  "herdr": [
    {"argv": ["agent", "get", "crew-worker"], "results": [{"agent": {"pane_id": "worker-1", "agent_status": "blocked"}}]},
    {"argv": ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"], "results": [{"stdout": "────────────────────────\n• Edited /private/tmp/edit-a.txt (+1 -1)\n    1 -old\n    1 +new\n\nWould you like to make the following edits?\n\nDescription: Apply proposed file edits\nDestination: /private/tmp/edit-a.txt\n\n1. Yes, proceed\n2. No\n"}]}
  ],
  "expect": {
    "status": 0,
    "stdout_contains": ["approval_kind=edit", "command_b64={command_b64}", "outcome=recorded"],
    "calls_exact": [["agent", "get", "crew-worker"], ["agent", "read", "crew-worker", "--source", "visible", "--lines", "200", "--format", "text"]],
    "json_files": {"{state}/run-1/approvals.jsonl": {"key": {"destinations": ["/private/tmp/edit-a.txt"], "operation": "modify"}, "kind": "edit", "sha256": "{command_sha256}"}}
  }
}
